# Moneo backend — local capstone demo configuration
#
# 1. Copy this file to ".env" in the same folder (backend/.env)
# 2. Get a free key at https://aistudio.google.com -> "Get API key"
#    (real Gemini keys start with "AIza")
# 3. Paste it below
# 4. Never commit the real .env file — it's already in .gitignore
#
# The frontend NEVER sees this key. Only this backend process reads it.

GEMINI_API_KEY=your_gemini_api_key_here

# Model used for both chat/insight and receipt vision. Kept in one place
# so it's never scattered through the code — change it here only.
GEMINI_MODEL=gemini-2.5-flash

# Port this backend listens on. The frontend expects it here by default
# (see VITE_BACKEND_URL in the frontend's .env.example).
PORT=4000

# Which websites may call this backend (comma-separated). Add your deployed
# frontend URL here, e.g. https://moneo.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timezone used for "today" when a receipt has no visible date.
APP_TIMEZONE=Asia/Seoul

# Optional: free CoinGecko "Demo" API key for the Market page (Bitcoin/Gold).
# The page works without it; a key just gives a higher rate limit.
# Get one at https://www.coingecko.com/en/api → "Get your free API key".
COINGECKO_API_KEY=
