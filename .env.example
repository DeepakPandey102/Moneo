# Moneo frontend — configuration
#
# The frontend does NOT need a Gemini API key. All AI calls (chat,
# insights, receipt scanning) go through the local backend, which is
# the only place that ever holds the real key. See backend/.env.example
# for that setup instead.

# Where the backend lives — default is correct for standard local setup.
VITE_BACKEND_URL=http://localhost:4000

# Supabase — real cloud database + login (replaces the old localStorage
# accounts). Get these from your Supabase project: Settings -> API.
#
# VITE_SUPABASE_ANON_KEY is safe to include here even though it ends up
# in browser code — it's Supabase's public "anon" key, meant to be used
# client-side. Real security comes from Row Level Security rules in the
# database (see backend/supabase_schema.sql), not from hiding this key.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google One Tap (the "Continue as …" popup). Optional — the normal
# "Continue with Google" button works without it. This is the same Web
# Client ID you paste into Supabase → Authentication → Providers → Google.
# It is public (not a secret). Never put the Client SECRET here.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
